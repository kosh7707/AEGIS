  "relationMethods": [
    {
      "id": "exact_id_match",
      "signalStrength": "strong",
      "allowedConsumerPolicies": [
        "contextual_only",
        "s3_may_derive_local_support_if_refs_validate",
        "scoped_no_hit_record_only"
      ],
      "canSupportNoHit": true,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "curated_mapping",
      "signalStrength": "strong",
      "allowedConsumerPolicies": [
        "contextual_only",
        "s3_may_derive_local_support_if_refs_validate"
      ],
      "canSupportNoHit": false,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "direct_source_relation",
      "signalStrength": "strong",
      "allowedConsumerPolicies": [
        "contextual_only",
        "s3_may_derive_local_support_if_refs_validate",
        "scoped_no_hit_record_only"
      ],
      "canSupportNoHit": true,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "provider_range_eval",
      "signalStrength": "strong-scoped",
      "allowedConsumerPolicies": [
        "contextual_only",
        "scoped_no_hit_record_only",
        "diagnostic_only"
      ],
      "canSupportNoHit": true,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "graph_expansion",
      "signalStrength": "medium",
      "allowedConsumerPolicies": [
        "contextual_only",
        "s3_may_derive_local_support_if_refs_validate",
        "diagnostic_only"
      ],
      "canSupportNoHit": false,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "keyword_match",
      "signalStrength": "weak",
      "allowedConsumerPolicies": [
        "contextual_only",
        "diagnostic_only",
        "do_not_use_as_negative_evidence"
      ],
      "canSupportNoHit": false,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "embedding_similarity",
      "signalStrength": "weak",
      "allowedConsumerPolicies": [
        "contextual_only",
        "diagnostic_only",
        "do_not_use_as_negative_evidence"
      ],
      "canSupportNoHit": false,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "constrained_embedding_rerank",
      "signalStrength": "medium-low",
      "allowedConsumerPolicies": [
        "contextual_only",
        "diagnostic_only",
        "do_not_use_as_negative_evidence"
      ],
      "canSupportNoHit": false,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "global_embedding_search",
      "signalStrength": "low",
      "allowedConsumerPolicies": [
        "contextual_only",
        "diagnostic_only",
        "do_not_use_as_negative_evidence"
      ],
      "canSupportNoHit": false,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1"
    },
    {
      "id": "profile_signal",
      "signalStrength": "context-only",
      "allowedConsumerPolicies": [
        "contextual_only",
        "diagnostic_only"
      ],
      "canSupportNoHit": false,
      "canCreateVulnerabilityTruth": false,
      "traceRequired": true,
      "methodVersion": "v1",
      "notes": "Specialization profile/tag signal. Additive retrieval/explanation context only; not core taxonomy truth."
    }
  ],
  "consumerPolicies": [
    {
      "id": "s3_may_derive_local_support_if_refs_validate",
      "claimSupportAllowed": "only_after_s3_validates_source_local_refs",
      "negativeEvidenceAllowed": false
    },
    {
      "id": "contextual_only",
      "claimSupportAllowed": false,
      "negativeEvidenceAllowed": false
    },
    {
      "id": "scoped_no_hit_record_only",
      "claimSupportAllowed": false,
      "negativeEvidenceAllowed": "only_as_scoped_no_hit_record_not_clean_pass"
    },
    {
      "id": "diagnostic_only",
      "claimSupportAllowed": false,
      "negativeEvidenceAllowed": false
    },
    {
      "id": "do_not_use",
      "claimSupportAllowed": false,
      "negativeEvidenceAllowed": false
    },
    {
      "id": "do_not_use_as_negative_evidence",
      "claimSupportAllowed": false,
      "negativeEvidenceAllowed": false
    }
  ],
  "relationProvenanceSchema": {
    "requiredFields": [
      "subjectId",
      "predicate",
      "objectId",
      "sourceKind",
      "sourceId",
      "sourceVersion",
      "sourceUrl",
      "method",
      "methodVersion",
      "confidence",
      "taxonomyFamily",
      "specializationProfiles",
      "matchedTerms",
      "score",
      "consumerPolicy",
      "createdAt",
      "freshness"
    ],
    "fieldNotes": {
      "method": "one of relationMethods.id",
      "specializationProfiles": "additive profile ids/tags only; not core taxonomy truth",
      "consumerPolicy": "one of consumerPolicies.id"
    }
  },
  "legacyCompatibility": {
    "threat_category": {
      "sourceOfTruth": false,
      "replacement": "coreTaxonomy.id",
      "notes": "legacy display/search category only until G006/G007 migration"
    },
    "attack_surfaces": {
      "sourceOfTruth": false,
      "replacement": "specializationProfiles[].tags[]",
      "notes": "legacy attack surfaces become profile signals"
    },
    "automotive_relevance": {
      "sourceOfTruth": false,
      "replacement": "profile signal score",
      "notes": "domain relevance is not vulnerability truth or no-hit evidence"
    }
  },
  "semanticGuards": {
    "automotiveIsProfileNotCore": true,
    "profilesAreAdditiveContextOnly": true,
    "keywordOrEmbeddingMissCannotNoHit": true,
    "weakMethodsCannotSupportNegativeEvidence": [
      "keyword_match",
      "embedding_similarity",
      "constrained_embedding_rerank",
      "global_embedding_search"
    ],
    "profileSignalCannotCreateTruthOrNoHit": true
  }
}
