      "expectedFindings": [
        {
          "id": "cjson-insert-item-null-deref",
          "cwe": "CWE-476",
          "riskClass": "null-pointer-dereference",
          "severity": "high",
          "minMatches": 1,
          "match": {
            "allKeywords": ["cJSON_InsertItemInArray"],
            "anyKeywords": ["CWE-476", "null pointer", "null dereference", "segmentation", "CVE-2023-50471"],
            "locationRegexes": ["cJSON\\.c"]
          },
          "sourceEvidence": [
            {"path": "cJSON.c", "lineStart": 2263, "lineEnd": 2288, "summary": "cJSON_InsertItemInArray dereferences newitem and newitem->prev without validating the replacement item state."}
          ],
          "poc": {"required": true, "diagnosticOnly": true, "requiredAnyKeywords": ["cJSON_InsertItemInArray", "null", "segmentation"]}
        }
      ],
      "negativeControls": ["Do not satisfy this case only with unrelated cJSON_Utils sprintf findings."]
    },
