{
  "schemaVersion": "hot11-full-pipeline-oracle-v1",
  "curatedAt": "2026-05-08",
  "curationScope": "hot11 Build -> Analyze -> Generate-PoC full-pipeline benchmark",
  "policy": {
    "passRequiresBuildCompleted": true,
    "passRequiresAnalysisCompleted": true,
    "passRequiresAllExpectedFindings": true,
    "passRequiresDiagnosticPocForMatchedFindings": true,
    "diagnosticOnly": true,
    "antiOverfitDirective": "This oracle encodes source-grounded vulnerability classes and locations; do not hard-code case-specific shortcuts in S3 code to satisfy it."
  },
  "cases": [
    {
      "caseId": "certificate-maker",
      "title": "certificate-maker / RE100 local seed",
      "expectedFindings": [
        {
          "id": "certificate-maker-popen-openssl-command-injection",
          "cwe": "CWE-78",
          "riskClass": "os-command-injection",
          "severity": "critical",
          "minMatches": 1,
          "match": {
            "allKeywords": ["popen", "openssl"],
            "anyKeywords": ["CWE-78", "command injection", "shell injection", "RCE", "remote code execution"],
            "locationRegexes": ["main\\.cpp"]
          },
          "sourceEvidence": [
            {"path": "main.cpp", "lineStart": 35, "lineEnd": 35, "summary": "run() executes caller-built shell strings with popen(cmd.c_str(), \"r\")."},
            {"path": "main.cpp", "lineStart": 156, "lineEnd": 240, "summary": "OpenSSL command strings interpolate certificate/profile fields before shell execution."}
          ],
          "poc": {"required": true, "diagnosticOnly": true, "requiredAnyKeywords": ["popen", "openssl", "command"]}
        }
      ],
      "negativeControls": ["Do not satisfy this case with generic OpenSSL CVEs outside certificate-maker/main.cpp."]
    },
    {
      "caseId": "cjson",
