{
  "schemaVersion": "s4-golden-corpus-v1",
  "analysisProfile": "c-cpp-core",
  "owner": "s4-sast-runner",
  "purpose": "Executable deterministic validation baseline for S4 static evidence contract, current six-tool capability skeletons, S3-consumable evidence bundles, claim-support readiness oracles, and C/C++ vulnerability-family canaries.",
  "expansionCriteria": [
    "Before tool portfolio governance, all four Golden Corpus v1 layers must have at least one executable representative and pass the manifest validator.",
    "Any future SAST tool addition/removal/upgrade must update toolCapabilityOracles with the affected tool id, expected evidence surfaces, known limits, and at least one fixture or benchmark pointer.",
    "Any future quality-improvement claim must add or update a vulnerabilityFamilyCanary or external benchmark slice that can fail before the implementation changes.",
    "Any new downstream-consumer assumption must be represented as either a contractOracle or evidenceBundleCorpus case before governance sign-off.",
    "No Golden Corpus case may require LLM calls, S5 calls, external vulnerability lookups, network access, or final security verdict fields."
  ],
